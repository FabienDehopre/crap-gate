<!--
  Canonical MTP coverage settings for the crap-gate backend lane.
  Copy to the repo root as coverage.config and pass it to dotnet test with --coverage-settings.
  Exclude only code that isn't ours, isn't production, or is entry-point wiring, plus deliberately
  untested files with a comment saying why. Never exclude to make a score go away.
  Path patterns use [\\/] so they match on Linux runners as well as Windows.
-->
<Configuration>
  <IncludeTestAssembly>False</IncludeTestAssembly>
  <CodeCoverage>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/].*\.Generated\.cs$</Source>
        <Source>.*[\\/].*\.g\.cs$</Source>
        <Source>.*[\\/].*_g\.cs$</Source>
        <Source>.*[\\/].*\.Tests[\\/].*\.cs$</Source>
        <Source>.*[\\/].*\.IntegrationTests[\\/].*\.cs$</Source>
        <!-- Composition root: host/DI bootstrap, exercised end-to-end. -->
        <Source>.*[\\/]Program\.cs$</Source>
        <!-- Per-repo additions below, each with a comment saying why. -->
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
